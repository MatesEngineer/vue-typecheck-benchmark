{
  "name": "vue-typecheck-benchmark",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "generate": "node scripts/generate-project.mjs",
    "check:vue-tsc": "node --max-old-space-size=4096 tools/vue-tsc/node_modules/vue-tsc/bin/vue-tsc.js --noEmit --pretty false -p tsconfig.vue-tsc.json",
    "check:vue-tsgo": "tsc --runExternalCode --noEmit --pretty false -p tsconfig.vue-content-mapper.json",
    "check:vue-tsrs": "tsrs --runExternalCode --noEmit --pretty false -p tsconfig.vue-content-mapper.json",
    "check:vize-tsgo": "tsc --runExternalCode --noEmit --pretty false -p tsconfig.vize-content-mapper.json",
    "check:vize-tsrs": "tsrs --runExternalCode --noEmit --pretty false -p tsconfig.vize-content-mapper.json",
    "check:vue-tsrs-fast": "tsrs --fast --runExternalCode --noEmit --pretty false -p tsconfig.vue-content-mapper.json",
    "check:vize-tsrs-fast": "tsrs --fast --runExternalCode --noEmit --pretty false -p tsconfig.vize-content-mapper.json",
    "check:vize-cli": "vize check --tsconfig tsconfig.base.json --format text",
    "verify": "node scripts/verify-diagnostics.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "benchmark:vize-checkers": "node scripts/benchmark-vize-checkers.mjs",
    "benchmark:memory": "node scripts/benchmark-memory.mjs"
  },
  "devDependencies": {
    "@vue/content-mapper": "4.0.0-alpha.3",
    "tsrs": "0.24.0-ts7.1.0-beta",
    "typescript": "7.1.0-beta",
    "vize": "0.742.0",
    "vite-plus": "1.3.0",
    "vue": "3.5.44"
  }
}
